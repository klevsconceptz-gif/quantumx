# ─────────────────────────────────────────────────────────────
# Quantum Space X — root environment (shared by all backends)
# Public domain: https://quantumx.win
# ─────────────────────────────────────────────────────────────

# Prisma (single shared SQLite datastore)
DATABASE_URL="file:./dev.db"

# Lightweight admin gate for the storefront's /admin area
ADMIN_PASSWORD="quantumx-admin"

# Public-facing site URL (brand domain)
NEXT_PUBLIC_SITE_URL="https://quantumx.win"
PUBLIC_DOMAIN="quantumx.win"

# Internal backend service URLs (same domain in production via reverse proxy;
# in this workspace each backend is its own process on its own port)
STORE_SERVICE_URL="http://localhost:4001"
CONSIGNMENT_SERVICE_URL="http://localhost:4002"
SHIPPING_SERVICE_URL="http://localhost:4003"
ORDERS_SERVICE_URL="http://localhost:4004"

# Ports each backend listens on
STORE_PORT=4001
CONSIGNMENT_PORT=4002
SHIPPING_PORT=4003
ORDERS_PORT=4004
